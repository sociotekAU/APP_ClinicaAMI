{
  "name": "app-clinica-ami",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:admin": "pnpm --filter @ami/admin dev",
    "dev:api": "pnpm --filter @ami/api dev",
    "db:check": "pnpm --filter @ami/database db:check",
    "db:generate": "pnpm --filter @ami/database db:generate",
    "db:pull": "pnpm --filter @ami/database db:pull",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
