POSTGRES_DB=clinica_ami
POSTGRES_USER=ami_admin
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1

# La aplicación acepta DATABASE_URL en despliegues. En desarrollo local puede
# construirla desde las variables POSTGRES_* anteriores.
DATABASE_URL=postgresql://ami_admin:replace_with_a_secure_password@127.0.0.1:5432/clinica_ami?schema=public
API_PORT=4000
ADMIN_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ADMIN_PERMISSION_PIN=replace_with_a_6_digit_numeric_pin
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api/v1
PRIVATE_STORAGE_ROOT=storage/private

# Genere valores distintos de al menos 32 caracteres para cada secreto.
JWT_ACCESS_SECRET=replace_with_a_random_access_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_refresh_secret_of_at_least_32_characters
JWT_ISSUER=ami-api
JWT_AUDIENCE=ami-admin
